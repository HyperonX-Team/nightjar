rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /incidents/{token}/audio.m4a {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'audio/mp4';
      allow delete: if false;
    }
  }
}
